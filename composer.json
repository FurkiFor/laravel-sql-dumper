{
    "name": "furkifor/sql_dumper",
    "description": "Laravel SQL dumper: see the raw SQL of any Eloquent or query builder query with bindings filled in, log and profile executed queries, detect N+1, plus a standalone PHP SQL query builder and migration tool.",
    "keywords": [
        "laravel",
        "sql",
        "sql-dumper",
        "raw-sql",
        "eloquent",
        "query-builder",
        "query-log",
        "debug",
        "n-plus-one",
        "bindings",
        "migration",
        "pdo",
        "php"
    ],
    "homepage": "https://github.com/FurkiFor/laravel-sql-dumper",
    "support": {
        "issues": "https://github.com/FurkiFor/laravel-sql-dumper/issues",
        "source": "https://github.com/FurkiFor/laravel-sql-dumper"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "furkan",
            "email": "furkanunsal69@gmail.com",
            "role": "Admin"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "ext-pdo": "Required to run queries and migrations with execute() / createTable()",
        "illuminate/database": "Enables the rawSql() / dumpSql() macros and QueryLog inside Laravel"
    },
    "autoload": {
        "psr-4": {
            "Furkifor\\SqlDumper\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Furkifor\\SqlDumper\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Furkifor\\SqlDumper\\Laravel\\SqlDumperServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
